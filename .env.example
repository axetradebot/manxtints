# Meta Pixel + Conversions API (CAPI)
# Public pixel id — safe to expose to the browser
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only CAPI access token (System User token from Events Manager). Keep secret.
META_CAPI_ACCESS_TOKEN=
# Dataset id for the Conversions API — same value as the pixel id
META_DATASET_ID=
# Optional: route server events to Events Manager > Test events for verification.
# Set to a TEST code from the Test events tab; leave UNSET in production.
META_TEST_EVENT_CODE=

# Lead capture
# Primary: StartMyPatch external-lead endpoint (receives quote/enquiry form JSON)
NEXT_PUBLIC_LEAD_ENDPOINT=
# Fallback: legacy Formspree endpoint, used only if the primary POST fails
NEXT_PUBLIC_LEAD_FALLBACK=

# Admin analytics dashboard (/admin)
ADMIN_PASSWORD=
# Postgres connection string for analytics events (e.g. Neon via Vercel).
# If unset, events fall back to a local .data/events.ndjson file (dev only —
# not durable on Vercel).
DATABASE_URL=

# Optional: Instagram feed on /gallery ("View our latest work on Instagram").
# Long-lived token for the @manxtintsltd business account via the Instagram API
# with Instagram Login. Expires after 60 days unless refreshed — see README.
# If unset, the gallery shows a follow card instead of live posts.
INSTAGRAM_ACCESS_TOKEN=

# Optional: Vercel Blob token for Quote Enquiry / Photo Quote uploads.
# If unset, photos store locally under .data/enquiry-photos/ (dev only).
BLOB_READ_WRITE_TOKEN=
# Signs photo URLs and photo-quote session tokens. Falls back to
# ADMIN_PASSWORD, then a dev constant — set it in production.
PHOTO_SIGNING_SECRET=

# Photo Quote (/quote → "Snap your windows for an instant quote")
# Server-only Anthropic key. Never prefixed NEXT_PUBLIC_. Feature is off until set.
ANTHROPIC_API_KEY=
# Only needed with a user-scoped key (sk-ant-usr-…): the workspace it should bill to.
# Workspace-scoped keys (sk-ant-api03-…) can leave this blank.
ANTHROPIC_WORKSPACE_ID=
# Vision model id. Default is the fastest vision model; any current Claude model works.
PHOTO_QUOTE_MODEL=claude-haiku-4-5
# Daily global spend cap in £ (default 10). Once reached, visitors are sent to the calculator.
PHOTO_QUOTE_DAILY_CAP_GBP=10
# Dev only: PHOTO_QUOTE_MOCK=1 returns a canned estimate (no key, no spend). Ignored in production.
# PHOTO_QUOTE_MOCK=1
# Optional cost-logging overrides (USD per million tokens, and USD→GBP rate; defaults by model / 0.78).
# PHOTO_QUOTE_INPUT_USD_PER_MTOK=
# PHOTO_QUOTE_OUTPUT_USD_PER_MTOK=
# PHOTO_QUOTE_USD_TO_GBP=0.78
# Cloudflare Turnstile — bot check before every estimate. Enforced when the secret is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vercel Cron auth for the daily photo purge (/api/photo-quote/purge). Vercel sets this automatically
# when you add it in the project's environment variables; any long random string.
CRON_SECRET=
